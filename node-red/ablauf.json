  {"id":"vorbereiten","type":"function","z":"beschaffung","name":"Anträge prüfen und entscheiden","func":"msg.vorbereitung = global.get('beschaffung').vorbereiten(msg.payload);\nreturn msg;","outputs":1,"timeout":0,"x":430,"y":120,"wires":[["exportieren"]]},
