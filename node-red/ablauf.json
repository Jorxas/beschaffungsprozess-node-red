  {"id":"sichern","type":"function","z":"beschaffung","name":"Momentaufnahme atomar sichern","func":"msg.payload = global.get('beschaffung').sichern(msg.vorbereitung);\nmsg.statusCode = 200;\ndelete msg.vorbereitung;\nreturn msg;","outputs":1,"timeout":0,"x":740,"y":200,"wires":[["ausgabe","antwortwahl"]]},
  {"id":"standeingang","type":"http in","z":"beschaffung","name":"Gespeicherten Stand lesen","url":"/beschaffung/stand","method":"get","upload":false,"swaggerDoc":"","x":160,"y":280,"wires":[["standlesen"]]},
  {"id":"standlesen","type":"function","z":"beschaffung","name":"Stand ohne neuen Prozesslauf","func":"msg.payload = global.get('beschaffung').lesen();\nmsg.statusCode = msg.payload ? 200 : 404;\nif (!msg.payload) msg.payload = {hinweis:'Noch keine Vorführung gespeichert.'};\nreturn msg;","outputs":1,"timeout":0,"x":450,"y":280,"wires":[["antwortwahl"]]},
