{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lokaler ERP-Exportentwurf für eine studentische Übung",
  "description": "Eigenes Übergabeformat. Keine SAP-OData-, BAPI- oder S/4-Spezifikation; keine tatsächliche Produktverbindung.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatversion", "exportkennung", "antrag_id", "betrag_cent", "waehrung", "genehmigt_am", "freigabe_person", "begruendung", "entscheidungskriterium"],
  "properties": {
    "formatversion": {"const": 1},
    "exportkennung": {"type": "string", "pattern": "^uebung-A[0-9]{2}$"},
    "antrag_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
    "betrag_cent": {"type": "integer", "minimum": 1, "maximum": 50000},
    "waehrung": {"const": "EUR"},
    "genehmigt_am": {"type": "string", "format": "date-time"},
    "freigabe_person": {"type": "string", "minLength": 1},
    "begruendung": {"type": "string", "minLength": 1},
    "entscheidungskriterium": {"type": "string", "minLength": 1}
  }
}
